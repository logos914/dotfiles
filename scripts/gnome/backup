#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Backup GNOME desktop, shell, and media-keys keybindings
##?
##? Usage:
##?   backup
docs::parse "$@"

if [[ -n "${DOTFILES_PATH:-}" ]]; then
  repo_root="$DOTFILES_PATH"
else
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi

if ! platform::is_gnome; then
  output::error "GNOME is required for this command"
  exit 1
fi

if ! platform::command_exists dconf; then
  output::error "dconf not found"
  exit 1
fi

mkdir -p "$repo_root/gnome"

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

{
  echo "# GENERATED by dot gnome backup — do not edit by hand"
  echo "# Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  dconf dump /org/gnome/desktop/wm/keybindings/
  dconf dump /org/gnome/shell/keybindings/
  dconf dump /org/gnome/settings-daemon/plugins/media-keys/
} >>"$tmp_file"

mv "$tmp_file" "$repo_root/gnome/shortcuts.dconf"

output::answer "Backed up GNOME shortcuts to gnome/shortcuts.dconf"
