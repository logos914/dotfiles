#!/usr/bin/env bash

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Bootstrap infisical secrets into secrets/envs.env
##?
##? Usage:
##?    bootstrap
##?
##? Env:
##?    DOTF_GITLAB_TOKEN    GitLab Project Access Token (scope read_api).
##?                         If unset, will prompt (TTY only).
##?    DOTF_GITLAB_HOST     Default: https://gitlab.com
##?    DOTF_GITLAB_PROJECT  Default: logos914/dotfiles
##?    DOTF_INFISICAL_ENV   Infisical environment slug. Default: envs
docs::parse "$@"

GITLAB_HOST=${DOTF_GITLAB_HOST:-https://gitlab.com}
GITLAB_PROJECT=${DOTF_GITLAB_PROJECT:-logos914/dotfiles}
GITLAB_ENCODED_PROJECT=$(printf '%s' "$GITLAB_PROJECT" | sed 's|/|%2F|g')

SECRETS_DIR="$DOTFILES_PATH/secrets"
SECRETS_FILE="$SECRETS_DIR/envs.env"
INFISICAL_ENV=${DOTF_INFISICAL_ENV:-envs}

_secrets::skip_no_token() {
  output::answer "⏭️  Skipping infisical bootstrap (no DOTF_GITLAB_TOKEN and no TTY)"
  exit 0
}

_secrets::already_bootstrapped() {
  [ -f "$SECRETS_FILE" ] && platform::command_exists infisical
}

_secrets::resolve_gitlab_token() {
  if [ -n "${DOTF_GITLAB_TOKEN:-}" ]; then
    return 0
  fi

  if [ "${DOTFILES_ENV:-PROD}" = "CI" ] || [ "${DOTFILES_INSTALLER:-false}" = "true" ] || [ ! -t 0 ]; then
    _secrets::skip_no_token
  fi

  local token
  if ! read -rsp "🔑 GitLab Project Access Token (read_api): " token; then
    echo
    _secrets::skip_no_token
  fi
  echo

  export DOTF_GITLAB_TOKEN="$token"
  unset token
}

_secrets::gitlab_fetch_variable() {
  local name="$1"
  local url="$GITLAB_HOST/api/v4/projects/$GITLAB_ENCODED_PROJECT/variables/$name"

  local response
  if ! response=$(curl -fsS --header "PRIVATE-TOKEN: $DOTF_GITLAB_TOKEN" "$url" 2>&1); then
    output::error "GitLab API call failed for $name: $response"
    return 1
  fi

  local value
  value=$(printf '%s' "$response" | sed -n 's/.*"value":"\([^"]*\)".*/\1/p')
  if [ -z "$value" ]; then
    output::error "Variable $name missing or empty in GitLab (check token scope is read_api and var exists)"
    return 1
  fi

  printf '%s' "$value"
}

_secrets::ensure_secrets_dir() {
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
}

_secrets::login_infisical() {
  local project="$1"
  local domain="$2"
  local token="$3"

  output::answer "🔐 Logging in to infisical ($domain, project $project)"
  infisical login \
    --method=service-token \
    --token="$token" \
    --projectId="$project" \
    --domain="$domain" \
    --silent
}

_secrets::export_envs() {
  local project="$1"
  local domain="$2"

  output::answer "📥 Dumping /envs to $SECRETS_FILE"
  umask 077

  if ! infisical export \
    --env="$INFISICAL_ENV" \
    --domain="$domain" \
    --projectId="$project" \
    --format=dotenv > "$SECRETS_FILE.tmp"; then
    rm -f "$SECRETS_FILE.tmp"
    output::error "infisical export failed"
    return 1
  fi

  {
    printf '# dotf-internal: INFISICAL_DOMAIN=%s\n' "$domain"
    printf '# dotf-internal: INFISICAL_PROJECT_ID=%s\n' "$project"
    printf '# dotf-internal: INFISICAL_ENV=%s\n' "$INFISICAL_ENV"
    printf '# Auto-generated by dot secrets bootstrap. Do not edit by hand.\n'
    cat "$SECRETS_FILE.tmp"
  } > "$SECRETS_FILE.meta"

  mv "$SECRETS_FILE.meta" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
  rm -f "$SECRETS_FILE.tmp"
}

_secrets::ensure_infisical_cli() {
  if platform::command_exists infisical; then
    return 0
  fi

  output::answer "infisical CLI not found, installing via recipe"
  "$DOTFILES_PATH/bin/dot" package add infisical || {
    output::error "Could not install infisical CLI"
    return 1
  }
}

main() {
  _secrets::ensure_infisical_cli

  if _secrets::already_bootstrapped; then
    output::answer "Already bootstrapped at $SECRETS_FILE (run 'dot secrets refresh' to update)"
    exit 0
  fi

  _secrets::resolve_gitlab_token

  local project url token
  project=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_PROJECT)
  url=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_URL)
  token=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_TOKEN_DEPLOY)

  _secrets::ensure_secrets_dir
  _secrets::login_infisical "$project" "$url" "$token"
  _secrets::export_envs "$project" "$url"

  unset token

  output::solution "✅ Infisical bootstrapped at $SECRETS_FILE"
  output::answer "Reload your shell or run: source $SECRETS_FILE"
}

main "$@"
