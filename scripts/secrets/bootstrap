#!/usr/bin/env bash

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Bootstrap infisical secrets into secrets/envs.env
##?
##? Usage:
##?    bootstrap
##?
##? Env:
##?    DOTF_GITLAB_TOKEN    GitLab Project Access Token (scope read_api).
##?                         Order: 1) explicit env var, 2) secrets/.gitlab-token
##?                         (saved on first run), 3) prompt on TTY.
##?    DOTF_GITLAB_HOST     Default: https://gitlab.com
##?    DOTF_GITLAB_PROJECT  Default: auto-detected from the gitlab git remote
##?    DOTF_INFISICAL_ENV   Infisical environment slug. Default: envs
docs::parse "$@"

GITLAB_HOST=${DOTF_GITLAB_HOST:-https://gitlab.com}

_secrets::auto_detect_gitlab_project() {
  if [ -n "${DOTF_GITLAB_PROJECT:-}" ]; then
    printf '%s' "$DOTF_GITLAB_PROJECT"
    return 0
  fi

  local url
  url=$(git config --get remote.gitlab.url 2>/dev/null || true)
  if [ -z "$url" ]; then
    url=$(git config --get remote.origin.url 2>/dev/null || true)
  fi

  local path
  path=$(printf '%s' "$url" | sed -E 's#^(git@|https?://)([^:/]+)[:/]+##; s#\.git$##')
  if [ -z "$path" ] || [ "$path" = "$url" ]; then
    printf 'Could not auto-detect GitLab project (set DOTF_GITLAB_PROJECT=<namespace>/<repo>)\n' >&2
    return 1
  fi

  printf '%s' "$path"
}

GITLAB_PROJECT=$(_secrets::auto_detect_gitlab_project) || exit 1
GITLAB_ENCODED_PROJECT=$(printf '%s' "$GITLAB_PROJECT" | sed 's|/|%2F|g')

SECRETS_DIR="$DOTFILES_PATH/secrets"
SECRETS_FILE="$SECRETS_DIR/envs.env"
SECRETS_TOKEN_FILE="$SECRETS_DIR/.infisical-token"
SECRETS_GITLAB_TOKEN_FILE="$SECRETS_DIR/.gitlab-token"
INFISICAL_ENV=${DOTF_INFISICAL_ENV:-envs}

_secrets::skip_no_token() {
  printf '⏭️  Skipping infisical bootstrap (no DOTF_GITLAB_TOKEN and no TTY)\n'
  exit 0
}

_secrets::already_bootstrapped() {
  [ -f "$SECRETS_FILE" ] && [ -f "$SECRETS_TOKEN_FILE" ] && platform::command_exists infisical
}

_secrets::resolve_gitlab_token() {
  if [ -n "${DOTF_GITLAB_TOKEN:-}" ]; then
    return 0
  fi

  # Already cached locally from a previous bootstrap — reuse it.
  if [ -f "$SECRETS_GITLAB_TOKEN_FILE" ]; then
    local cached
    cached=$(cat "$SECRETS_GITLAB_TOKEN_FILE" 2>/dev/null)
    if [ -n "$cached" ]; then
      printf '🔁 Reusing cached GitLab PAT from %s\n' "$SECRETS_GITLAB_TOKEN_FILE"
      export DOTF_GITLAB_TOKEN="$cached"
      unset cached
      return 0
    fi
  fi

  if [ "${DOTFILES_ENV:-PROD}" = "CI" ] || [ "${DOTFILES_INSTALLER:-false}" = "true" ] || [ ! -t 0 ]; then
    _secrets::skip_no_token
  fi

  local token
  if ! read -rsp "🔑 GitLab Project Access Token (read_api): " token; then
    echo
    _secrets::skip_no_token
  fi
  echo

  export DOTF_GITLAB_TOKEN="$token"
  unset token
}

_secrets::persist_gitlab_token() {
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
  umask 077
  printf '%s' "$DOTF_GITLAB_TOKEN" > "$SECRETS_GITLAB_TOKEN_FILE"
  chmod 600 "$SECRETS_GITLAB_TOKEN_FILE"
}

_secrets::gitlab_fetch_variable() {
  local name="$1"
  local body_file
  body_file=$(mktemp 2>/dev/null) || {
    printf 'mktemp failed\n' >&2
    return 1
  }

  local http_code
  http_code=$(curl -sS -o "$body_file" -w '%{http_code}' \
    --header "PRIVATE-TOKEN: $DOTF_GITLAB_TOKEN" \
    "$GITLAB_HOST/api/v4/projects/$GITLAB_ENCODED_PROJECT/variables/$name" 2>/dev/null) || {
    rm -f "$body_file"
    printf 'GitLab curl failed for %s\n' "$name" >&2
    return 1
  }

  local body
  body=$(cat "$body_file")
  rm -f "$body_file"

  if [ "$http_code" != "200" ]; then
    printf 'GitLab %s for %s: %s\n' "$http_code" "$name" "$body" >&2
    return 1
  fi

  local value
  value=$(printf '%s' "$body" | sed -n 's/.*"value":"\([^"]*\)".*/\1/p')
  if [ -z "$value" ]; then
    printf 'Variable %s missing/empty in GitLab (check token scope read_api and var on %s/%s)\n' \
      "$name" "$GITLAB_HOST" "$GITLAB_PROJECT" >&2
    return 1
  fi

  printf '%s' "$value"
}

# Extra validation: spec-style UUID (8-4-4-4-12 hex). Used for the
# infisical project id, since the CLI rejects slugs.
_secrets::looks_like_uuid() {
  printf '%s' "$1" | grep -qE '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
}

_secrets::gitlab_fetch_project_id() {
  local value
  if ! value=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_PROJECT_ID); then
    return 1
  fi
  if ! _secrets::looks_like_uuid "$value"; then
    printf '%s = %q does not look like a UUID (probably a project slug). Use the UUID from Infisical Project Settings.\n' \
      "DOTF_INFISICAL_PROJECT_ID" "$value" >&2
    return 1
  fi
  printf '%s' "$value"
}

_secrets::ensure_secrets_dir() {
  mkdir -p "$SECRETS_DIR"
  chmod 700 "$SECRETS_DIR"
}

# Write the infisical credentials bundle (domain, project id, service token)
# as KEY=VALUE lines. Used by `dot secrets refresh` to skip the GitLab fetch.
_secrets::persist_infisical_creds() {
  local project="$1"
  local domain="$2"
  local token="$3"

  umask 077
  {
    printf '# dotf-internal credentials bundle for dot secrets refresh\n'
    printf '# Auto-generated by dot secrets bootstrap. Do not edit by hand.\n'
    printf 'INFISICAL_DOMAIN=%s\n' "$domain"
    printf 'INFISICAL_PROJECT_ID=%s\n' "$project"
    printf 'INFISICAL_SERVICE_TOKEN=%s\n' "$token"
    printf 'INFISICAL_ENV=%s\n' "$INFISICAL_ENV"
  } > "$SECRETS_TOKEN_FILE"

  chmod 600 "$SECRETS_TOKEN_FILE"
}

_secrets::export_envs() {
  local project="$1"
  local domain="$2"
  local token="$3"

  printf '📥 Dumping /envs to %s\n' "$SECRETS_FILE"
  umask 077

  if ! infisical export \
    --env="$INFISICAL_ENV" \
    --domain="$domain" \
    --projectId="$project" \
    --token="$token" \
    --format=dotenv > "$SECRETS_FILE.tmp"; then
    rm -f "$SECRETS_FILE.tmp"
    printf 'infisical export failed (check token, projectId, domain)\n' >&2
    return 1
  fi

  {
    printf '# dotf-internal: INFISICAL_DOMAIN=%s\n' "$domain"
    printf '# dotf-internal: INFISICAL_PROJECT_ID=%s\n' "$project"
    printf '# dotf-internal: INFISICAL_ENV=%s\n' "$INFISICAL_ENV"
    printf '# Auto-generated by dot secrets bootstrap. Do not edit by hand.\n'
    cat "$SECRETS_FILE.tmp"
  } > "$SECRETS_FILE.meta"

  mv "$SECRETS_FILE.meta" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
  rm -f "$SECRETS_FILE.tmp"
  return 0
}

_secrets::ensure_infisical_cli() {
  if platform::command_exists infisical; then
    return 0
  fi

  printf 'infisical CLI not found, installing via recipe\n'
  "$DOTFILES_PATH/bin/dot" package add infisical || {
    printf 'Could not install infisical CLI\n' >&2
    return 1
  }
}

main() {
  _secrets::ensure_infisical_cli

  if _secrets::already_bootstrapped; then
    printf '✅ Already bootstrapped at %s (run dot secrets refresh to update)\n' "$SECRETS_FILE"
    exit 0
  fi

  _secrets::resolve_gitlab_token
  _secrets::persist_gitlab_token

  local project url token
  if ! project=$(_secrets::gitlab_fetch_project_id); then
    exit 1
  fi
  if ! url=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_URL); then
    exit 1
  fi
  if ! token=$(_secrets::gitlab_fetch_variable DOTF_INFISICAL_SERVICE_TOKEN); then
    exit 1
  fi

  _secrets::ensure_secrets_dir
  _secrets::persist_infisical_creds "$project" "$url" "$token"

  if ! _secrets::export_envs "$project" "$url" "$token"; then
    exit 1
  fi

  unset token DOTF_GITLAB_TOKEN

  printf '✅ Infisical bootstrapped at %s\n' "$SECRETS_FILE"
  printf '   GitLab PAT cached at %s (mode 600)\n' "$SECRETS_GITLAB_TOKEN_FILE"
  printf '   Infisical creds cached at %s (mode 600)\n' "$SECRETS_TOKEN_FILE"
  printf '   Reload your shell or run: source %s\n' "$SECRETS_FILE"
}

main "$@"
