#!/usr/bin/env bash

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Re-dump infisical envs into secrets/envs.env (no GitLab re-fetch)
##?
##? Usage:
##?    refresh
##?
##? Env:
##?    DOTF_INFISICAL_ENV          Infisical environment slug. Default: envs
##?    DOTF_INFISICAL_DOMAIN       Override (defaults from credentials bundle)
##?    DOTF_INFISICAL_PROJECT_ID   Override (defaults from credentials bundle)
##?    DOTF_INFISICAL_SERVICE_TOKEN Override service token (defaults to
##?                                secrets/.infisical-token)
docs::parse "$@"

SECRETS_DIR="$DOTFILES_PATH/secrets"
SECRETS_FILE="$SECRETS_DIR/envs.env"
SECRETS_TOKEN_FILE="$SECRETS_DIR/.infisical-token"
INFISICAL_ENV=${DOTF_INFISICAL_ENV:-envs}

_refresh::require_cli() {
  platform::command_exists infisical || {
    printf 'infisical CLI not installed. Run: dot package add infisical\n' >&2
    exit 1
  }
}

_refresh::require_creds() {
  if [ ! -f "$SECRETS_TOKEN_FILE" ]; then
    printf 'No credentials at %s. Run first: dot secrets bootstrap\n' "$SECRETS_TOKEN_FILE" >&2
    exit 1
  fi
}

# Reads a single KEY=VALUE from the credentials bundle. Quotes not handled.
_refresh::cred() {
  local key="$1"
  local file="$SECRETS_TOKEN_FILE"
  [ -f "$file" ] || return 1
  # Match KEY= up to the next newline (no quoting assumed)
  sed -n "s/^${key}=//p" "$file" | head -n1
}

_refresh::do_export() {
  local project="$1"
  local domain="$2"
  local token="$3"

  printf '📥 Refreshing /envs into %s\n' "$SECRETS_FILE"
  umask 077

  if ! infisical export \
    --env="$INFISICAL_ENV" \
    --domain="$domain" \
    --projectId="$project" \
    --token="$token" \
    --format=dotenv > "$SECRETS_FILE.tmp"; then
    rm -f "$SECRETS_FILE.tmp"
    printf 'infisical export failed\n' >&2
    return 1
  fi

  {
    printf '# dotf-internal: INFISICAL_DOMAIN=%s\n' "$domain"
    printf '# dotf-internal: INFISICAL_PROJECT_ID=%s\n' "$project"
    printf '# dotf-internal: INFISICAL_ENV=%s\n' "$INFISICAL_ENV"
    printf '# Auto-generated by dot secrets refresh. Do not edit by hand.\n'
    cat "$SECRETS_FILE.tmp"
  } > "$SECRETS_FILE.meta"

  mv "$SECRETS_FILE.meta" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
  rm -f "$SECRETS_FILE.tmp"
}

main() {
  _refresh::require_cli
  _refresh::require_creds

  local domain project token
  domain=${DOTF_INFISICAL_DOMAIN:-$(_refresh::cred INFISICAL_DOMAIN)}
  project=${DOTF_INFISICAL_PROJECT_ID:-$(_refresh::cred INFISICAL_PROJECT_ID)}
  token=${DOTF_INFISICAL_SERVICE_TOKEN:-$(_refresh::cred INFISICAL_SERVICE_TOKEN)}

  if [ -z "$domain" ] || [ -z "$project" ] || [ -z "$token" ]; then
    printf 'Missing INFISICAL_DOMAIN, INFISICAL_PROJECT_ID or INFISICAL_SERVICE_TOKEN in %s. Re-run: dot secrets bootstrap\n' "$SECRETS_TOKEN_FILE" >&2
    exit 1
  fi

  _refresh::do_export "$project" "$domain" "$token"
  unset token
  printf '✅ Secrets refreshed at %s\n' "$SECRETS_FILE"
}

main "$@"
