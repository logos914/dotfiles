#!/usr/bin/env bash

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Re-dump infisical envs into secrets/envs.env (no GitLab re-fetch)
##?
##? Usage:
##?    refresh
##?
##? Env:
##?    DOTF_INFISICAL_ENV          Infisical environment slug. Default: envs
##?    DOTF_INFISICAL_DOMAIN       Override (defaults read from envs.env header)
##?    DOTF_INFISICAL_PROJECT_ID   Override (defaults read from envs.env header)
##?    DOTF_INFISICAL_TOKEN        Override the service token (defaults to
##?                                secrets/.infisical-token written by bootstrap)
docs::parse "$@"

SECRETS_DIR="$DOTFILES_PATH/secrets"
SECRETS_FILE="$SECRETS_DIR/envs.env"
SECRETS_TOKEN_FILE="$SECRETS_DIR/.infisical-token"
INFISICAL_ENV=${DOTF_INFISICAL_ENV:-envs}

_refresh::require_cli() {
  platform::command_exists infisical || {
    output::error "infisical CLI not installed. Run: dot package add infisical"
    exit 1
  }
}

_refresh::require_existing_dump() {
  if [ ! -f "$SECRETS_FILE" ]; then
    output::error "No previous secrets/envs.env found. Run first: dot secrets bootstrap"
    exit 1
  fi
}

_refresh::read_meta() {
  local key="$1"
  local file="$SECRETS_FILE"

  if [ ! -f "$file" ]; then
    return 1
  fi

  grep -E "^# dotf-internal:[[:space:]]*${key}=" "$file" |
    sed -E "s/^# dotf-internal:[[:space:]]*${key}=//"
}

_refresh::resolve_token() {
  if [ -n "${DOTF_INFISICAL_TOKEN:-}" ]; then
    printf '%s' "$DOTF_INFISICAL_TOKEN"
    return 0
  fi

  if [ ! -f "$SECRETS_TOKEN_FILE" ]; then
    output::error "No service token found at $SECRETS_TOKEN_FILE. Run: dot secrets bootstrap"
    exit 1
  fi

  cat "$SECRETS_TOKEN_FILE"
}

_refresh::do_export() {
  local project="$1"
  local domain="$2"
  local token="$3"

  output::answer "📥 Refreshing /envs into $SECRETS_FILE"
  umask 077

  if ! infisical export \
    --env="$INFISICAL_ENV" \
    --domain="$domain" \
    --projectId="$project" \
    --token="$token" \
    --format=dotenv > "$SECRETS_FILE.tmp"; then
    rm -f "$SECRETS_FILE.tmp"
    output::error "infisical export failed"
    return 1
  fi

  {
    printf '# dotf-internal: INFISICAL_DOMAIN=%s\n' "$domain"
    printf '# dotf-internal: INFISICAL_PROJECT_ID=%s\n' "$project"
    printf '# dotf-internal: INFISICAL_ENV=%s\n' "$INFISICAL_ENV"
    printf '# Auto-generated by dot secrets refresh. Do not edit by hand.\n'
    cat "$SECRETS_FILE.tmp"
  } > "$SECRETS_FILE.meta"

  mv "$SECRETS_FILE.meta" "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
  rm -f "$SECRETS_FILE.tmp"
}

main() {
  _refresh::require_cli
  _refresh::require_existing_dump

  local domain project token
  domain=${DOTF_INFISICAL_DOMAIN:-$(_refresh::read_meta INFISICAL_DOMAIN)}
  project=${DOTF_INFISICAL_PROJECT_ID:-$(_refresh::read_meta INFISICAL_PROJECT_ID)}
  token=$(_refresh::resolve_token)

  if [ -z "$domain" ] || [ -z "$project" ] || [ -z "$token" ]; then
    output::error "Missing INFISICAL_DOMAIN, INFISICAL_PROJECT_ID or token. Re-run: dot secrets bootstrap"
    exit 1
  fi

  _refresh::do_export "$project" "$domain" "$token"
  unset token
  output::solution "✅ Secrets refreshed at $SECRETS_FILE"
}

main "$@"
