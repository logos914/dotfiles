#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Apply all symlinks
##?
##? Usage:
##?    apply
##?
docs::parse "$@"

current_timestamp() { date +%s; }

# Links $1 (inside the repository) into $2 ($HOME), backing up whatever was
# already there. It is idempotent: an already correct symlink is left alone.
symlinks::link() {
  local -r origin="$1"
  local -r destination="$2"

  if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$origin" ]; then
    return 0
  fi

  if [ -e "$destination" ] || [ -L "$destination" ]; then
    local backup_path
    backup_path="$destination.$(current_timestamp).back"

    output::answer "Backing up \`$destination\` in \`$backup_path\`"
    mv "$destination" "$backup_path"
  fi

  mkdir -p "$(dirname "$destination")"
  ln -s "$origin" "$destination"
}

# Links every item of the repository directory $1 into the directory $2,
# instead of linking $2 itself, so the tool keeps its own state (sessions,
# caches, credentials) outside of the dotfiles.
symlinks::link_directory_content() {
  local -r origin_directory="$1"
  local -r destination_directory="$2"

  [ -d "$origin_directory" ] || return 0

  mkdir -p "$destination_directory"

  local item
  for item in "$origin_directory"/* "$origin_directory"/.[!.]*; do
    [ -e "$item" ] || continue

    symlinks::link "$item" "$destination_directory/$(basename "$item")"
  done
}

config_path="${XDG_CONFIG_HOME:-$HOME/.config}"

symlinks::link "$DOTFILES_PATH/shell/.inputrc" "$HOME/.inputrc"

# Bash

symlinks::link "$DOTFILES_PATH/shell/bash/.bashrc" "$HOME/.bashrc"
symlinks::link "$DOTFILES_PATH/shell/bash/.bash_profile" "$HOME/.bash_profile"

# Zsh

symlinks::link "$DOTFILES_PATH/shell/zsh/.zlogin" "$HOME/.zlogin"
symlinks::link "$DOTFILES_PATH/shell/zsh/.zshenv" "$HOME/.zshenv"
symlinks::link "$DOTFILES_PATH/shell/zsh/.zshrc" "$HOME/.zshrc"
symlinks::link "$DOTFILES_PATH/shell/zsh/.zimrc" "$HOME/.zimrc"

# Git

symlinks::link "$DOTFILES_PATH/git/.gitattributes" "$HOME/.gitattributes"
symlinks::link "$DOTFILES_PATH/git/.gitconfig" "$HOME/.gitconfig"
symlinks::link "$DOTFILES_PATH/git/.gitignore_global" "$HOME/.gitignore_global"

# Claude Code

symlinks::link_directory_content "$DOTFILES_PATH/claude" "$HOME/.claude"

# opencode

symlinks::link_directory_content "$DOTFILES_PATH/opencode" "$config_path/opencode"

log::success "Done!"
